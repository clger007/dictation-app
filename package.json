{
  "name": "dictation-app",
  "version": "0.0.0",
  "description": "Cross-platform (macOS + Linux) hotkey dictation — Electron port of dictate.py. M0 skeleton.",
  "main": "dist/main/index.js",
  "author": "",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "start": "npm run build && electron .",
    "dev": "npm run build && electron . --enable-logging",
    "clean": "rimraf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "^33.2.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "smol-toml": "^1.3.1"
  }
}
